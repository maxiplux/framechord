{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "properties": {
        "loudness_lufs": {
          "description": "Optional integrated loudness target; peak ceiling is -1 dBFS.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pause_ms": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "turn_gain_db": {
          "additionalProperties": {
            "format": "float",
            "type": "number"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "AssetOrigin": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "default": {
            "duration_seconds": null,
            "format": null,
            "image_quality": null,
            "instrumental": null,
            "seed": null,
            "size": null,
            "voice": null
          }
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "selection",
        "sha256"
      ],
      "type": "object"
    },
    "AudioFormat": {
      "description": "Published audio container for audiobook chapters and the full book.",
      "enum": [
        "wav",
        "mp3"
      ],
      "type": "string"
    },
    "AudiobookPlan": {
      "additionalProperties": false,
      "description": "Resolved audiobook packaging carried by book and chapter jobs, never by provider leaves.",
      "properties": {
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChapterInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "$ref": "#/$defs/AudioFormat"
        },
        "mp3_bitrate_kbps": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "output_mode": {
          "$ref": "#/$defs/OutputMode"
        },
        "role": {
          "$ref": "#/$defs/AudiobookRole"
        },
        "selected": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "output_mode",
        "format",
        "mp3_bitrate_kbps"
      ],
      "type": "object"
    },
    "AudiobookRole": {
      "enum": [
        "book",
        "chapter"
      ],
      "type": "string"
    },
    "ChapterInfo": {
      "additionalProperties": false,
      "properties": {
        "chars": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "description": "One-based position in the complete book, stable across chapter subsets.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "spoken_title": {
          "type": "boolean"
        },
        "text_sha256": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "count",
        "spoken_title",
        "source",
        "text_sha256",
        "chars"
      ],
      "type": "object"
    },
    "Media": {
      "enum": [
        "image",
        "infographic",
        "speech",
        "podcast",
        "audiobook",
        "music",
        "sfx",
        "text"
      ],
      "type": "string"
    },
    "OutputMode": {
      "description": "`chapters` publishes one file per chapter; `full` also publishes the combined book.",
      "enum": [
        "chapters",
        "full"
      ],
      "type": "string"
    },
    "Provider": {
      "enum": [
        "openai",
        "google",
        "fish",
        "openrouter",
        "elevenlabs"
      ],
      "type": "string"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "base64": {
          "type": "string"
        },
        "blob": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        },
        "sha256": {
          "type": "string"
        },
        "transcript": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "name",
        "mime",
        "sha256"
      ],
      "type": "object"
    },
    "ReferenceRole": {
      "enum": [
        "identity",
        "style",
        "layout",
        "content"
      ],
      "type": "string"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_fidelity": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrumental": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assembly": {
      "anyOf": [
        {
          "$ref": "#/$defs/Assembly"
        },
        {
          "type": "null"
        }
      ]
    },
    "audiobook": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudiobookPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "character_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    },
    "media": {
      "$ref": "#/$defs/Media"
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array"
    },
    "selection": {
      "$ref": "#/$defs/Selection"
    },
    "settings": {
      "$ref": "#/$defs/Settings"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "turns": {
      "default": [],
      "items": {
        "$ref": "#"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "media",
    "selection",
    "prompt",
    "settings",
    "references",
    "depends_on"
  ],
  "title": "Effective",
  "type": "object"
}