{
  "$defs": {
    "Assembly": {
      "additionalProperties": false,
      "properties": {
        "loudness_lufs": {
          "description": "Optional integrated loudness target; peak ceiling is -1 dBFS.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "pause_ms": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "turn_gain_db": {
          "additionalProperties": {
            "format": "float",
            "type": "number"
          },
          "default": {},
          "type": "object"
        }
      },
      "type": "object"
    },
    "AssetOrigin": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "default": {
            "duration_seconds": null,
            "format": null,
            "image_quality": null,
            "instrumental": null,
            "seed": null,
            "size": null,
            "voice": null
          }
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "selection",
        "sha256"
      ],
      "type": "object"
    },
    "AudioFormat": {
      "description": "Published audio container for audiobook chapters and the full book.",
      "enum": [
        "wav",
        "mp3"
      ],
      "type": "string"
    },
    "AudiobookOptions": {
      "additionalProperties": false,
      "properties": {
        "announce_titles": {
          "default": false,
          "description": "Speak each chapter title before its text.",
          "type": "boolean"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "$ref": "#/$defs/AudioFormat",
          "default": "wav"
        },
        "max_chars_per_request": {
          "description": "Upper bound for one provider request; never above the model's own limit.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mp3_bitrate_kbps": {
          "description": "Constant MP3 bitrate at the 24 kHz mono working rate: 8, 16, 24, 32, 40, 48, 64, 80,\n96, 112, 128 or 160 kbps (default 64).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_mode": {
          "$ref": "#/$defs/OutputMode",
          "default": "full"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CastMember": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "character": {
          "type": "string"
        },
        "direction": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "alias",
        "character"
      ],
      "type": "object"
    },
    "Chapter": {
      "additionalProperties": false,
      "description": "One explicitly listed audiobook chapter; its text file holds the exact narrated words.",
      "properties": {
        "brief": {
          "description": "Optional chapter-specific delivery direction; never spoken.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "default": {
            "duration_seconds": null,
            "format": null,
            "image_quality": null,
            "instrumental": null,
            "seed": null,
            "size": null,
            "voice": null
          }
        },
        "text_file": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "text_file"
      ],
      "type": "object"
    },
    "EmptyPolicy": {
      "enum": [
        "skip",
        "error"
      ],
      "type": "string"
    },
    "InfoReference": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ReferenceRole"
        }
      },
      "required": [
        "path",
        "role"
      ],
      "type": "object"
    },
    "JobReference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/InfoReference"
        }
      ],
      "description": "A legacy plain path, or an explicitly role-labelled image reference."
    },
    "Media": {
      "enum": [
        "image",
        "infographic",
        "speech",
        "podcast",
        "audiobook",
        "music",
        "sfx",
        "text"
      ],
      "type": "string"
    },
    "OutputMode": {
      "description": "`chapters` publishes one file per chapter; `full` also publishes the combined book.",
      "enum": [
        "chapters",
        "full"
      ],
      "type": "string"
    },
    "PreamblePolicy": {
      "enum": [
        "include",
        "skip"
      ],
      "type": "string"
    },
    "Provider": {
      "enum": [
        "openai",
        "google",
        "fish",
        "openrouter",
        "elevenlabs"
      ],
      "type": "string"
    },
    "ReferenceRole": {
      "enum": [
        "identity",
        "style",
        "layout",
        "content"
      ],
      "type": "string"
    },
    "Selection": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "Settings": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_fidelity": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrumental": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "voice": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Split": {
      "additionalProperties": false,
      "description": "How a Markdown manuscript is divided into chapters. Only ATX headings are boundaries.",
      "properties": {
        "empty_chapters": {
          "$ref": "#/$defs/EmptyPolicy",
          "default": "skip"
        },
        "heading_level": {
          "format": "uint8",
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "preamble": {
          "$ref": "#/$defs/PreamblePolicy",
          "default": "include"
        }
      },
      "required": [
        "heading_level"
      ],
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Selection"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "default": {
            "duration_seconds": null,
            "format": null,
            "image_quality": null,
            "instrumental": null,
            "seed": null,
            "size": null,
            "voice": null
          }
        },
        "text_file": {
          "type": "string"
        },
        "voice_samples": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VoiceSample"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "text_file"
      ],
      "type": "object"
    },
    "VoiceSample": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "type": "string"
        },
        "consent": {
          "type": "string"
        },
        "transcript": {
          "type": "string"
        }
      },
      "required": [
        "audio",
        "transcript",
        "consent"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "assembly": {
            "type": "null"
          },
          "audiobook": {
            "type": "null"
          },
          "cast": {
            "maxItems": 0
          },
          "chapters": {
            "maxItems": 0
          },
          "manuscript": {
            "type": "null"
          },
          "media": {
            "not": {
              "const": "audiobook"
            }
          },
          "split": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "assembly": {
      "anyOf": [
        {
          "$ref": "#/$defs/Assembly"
        },
        {
          "type": "null"
        }
      ]
    },
    "audiobook": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudiobookOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "brief": {
      "type": [
        "string",
        "null"
      ]
    },
    "cast": {
      "items": {
        "$ref": "#/$defs/CastMember"
      },
      "type": "array"
    },
    "chapters": {
      "description": "Audiobook source: explicit ordered chapters.",
      "items": {
        "$ref": "#/$defs/Chapter"
      },
      "type": "array"
    },
    "character": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "id": {
      "type": "string"
    },
    "locale": {
      "type": [
        "string",
        "null"
      ]
    },
    "manuscript": {
      "description": "Audiobook source: one Markdown manuscript split at headings.",
      "type": [
        "string",
        "null"
      ]
    },
    "media": {
      "$ref": "#/$defs/Media"
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/JobReference"
      },
      "type": "array"
    },
    "schema_version": {
      "format": "uint32",
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "#/$defs/Settings",
      "default": {
        "duration_seconds": null,
        "format": null,
        "image_quality": null,
        "instrumental": null,
        "seed": null,
        "size": null,
        "voice": null
      }
    },
    "spec": {
      "type": [
        "string",
        "null"
      ]
    },
    "split": {
      "anyOf": [
        {
          "$ref": "#/$defs/Split"
        },
        {
          "type": "null"
        }
      ]
    },
    "text_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "turns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "type": "array"
    },
    "voice_samples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/VoiceSample"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "media"
  ],
  "title": "Job",
  "type": "object"
}